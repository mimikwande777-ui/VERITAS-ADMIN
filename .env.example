# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# PUBLIC CLIENT CONFIGURATION (STOREFRONT & ADMIN AUTH)
# ==============================================================================
# Public URL of the Supabase project
NEXT_PUBLIC_SUPABASE_URL="https://cdzvmnixlhjjrpyoaemg.supabase.co"

# Public anon/publishable client key for browser-side Supabase Auth and queries
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project API Keys (anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ==============================================================================
# SERVER CONFIGURATION (SERVER-SIDE ONLY - CONFIGURE IN ENVIRONMENT SETTINGS)
# ==============================================================================
# Server-only service-role secret key (Bypasses RLS for secure server checkout & admin operations)
# CRITICAL SECURITY: Never prefix with NEXT_PUBLIC_. Server-side only. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# ADMIN AUTHENTICATION (Development Only)
# Set to 'true' to enable local dev bypass. Defaults to 'false' (production always enforces authentication).
ADMIN_AUTH_BYPASS="false"
